# ─── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── API Güvenlik ────────────────────────────────────────
# SigalMedia ↔ AudioService arasındaki gizli anahtar
AUDIO_SERVICE_API_KEY=sigalmedia_super_secret_key_2024

# ─── Cloudflare R2 ───────────────────────────────────────
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_NAME=sigalmedia-audio
# Public CDN adresi (Cloudflare R2 → Custom Domain veya Public URL)
R2_PUBLIC_CDN=https://cdn.sigalmedia.com

# ─── Redis (Önbellek) ────────────────────────────────────
# Upstash Redis (ücretsiz tier kullanılabilir)
REDIS_URL=redis://localhost:6379
# TTL: kaç saniye cache'de tutsun (7 gün = 604800)
CACHE_TTL=604800

# ─── Firebase Admin SDK ──────────────────────────────────
FIREBASE_PROJECT_ID=music-c39c2
FIREBASE_CLIENT_EMAIL=your_service_account_email@music-c39c2.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ─── yt-dlp Ayarları ─────────────────────────────────────
# Maksimum izin verilen video süresi (saniye) — 10 dakika
MAX_DURATION_SECONDS=600
# yt-dlp binary yolu (Dockerfile'da /usr/local/bin/yt-dlp)
YTDLP_PATH=yt-dlp
# Geçici indirme klasörü
TEMP_DIR=/tmp/sigal-audio
